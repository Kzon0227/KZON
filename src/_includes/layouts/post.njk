---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta">
      {{ date | postDate }}
      {% if tags %}
        {% for tag in tags %}
          {% if tag != "posts" %}<span class="tag">{{ tag }}</span>{% endif %}
        {% endfor %}
      {% endif %}
    </p>
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>

<p class="back-link"><a href="{{ '/' | url }}">&larr; Back to all posts</a></p>
