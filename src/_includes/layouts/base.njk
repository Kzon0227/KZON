<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    (function () {
      var theme = "dark";
      try {
        var saved = localStorage.getItem("kzon-theme");
        if (saved === "light" || saved === "dark") theme = saved;
      } catch (err) {}
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <title>{% if title %}{{ title }} · {% endif %}KZON Blog</title>
  <meta name="description" content="{{ description or 'A blog about ideas worth writing down.' }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="icon" href="data:,">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="{{ '/' | url }}">KZON</a>
      <nav class="site-nav">
        <a href="{{ '/' | url }}">Home</a>
        <a href="{{ '/about/' | url }}">About</a>
        <a href="{{ '/new-post/' | url }}">Write</a>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to light mode">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {{ currentYear }} KZON. Built with Eleventy, hosted on GitHub Pages.</p>
    </div>
  </footer>

  <script>
    (function () {
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var html = document.documentElement;
        var next = html.getAttribute("data-theme") === "light" ? "dark" : "light";
        html.setAttribute("data-theme", next);
        btn.setAttribute("aria-label", next === "light" ? "Switch to dark mode" : "Switch to light mode");
        try { localStorage.setItem("kzon-theme", next); } catch (err) {}
      });
    })();
  </script>
</body>
</html>
